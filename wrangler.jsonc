{
  "name": "turf-nova-ai-2",
  "compatibility_date": "2026-08-01",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "5ce12447f8b641279bc706893a6e8bc3"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "turf-nova-db",
      "database_id": "9e74bb9b-22d1-4945-805b-3a3d48590b65"
    }
  ],
  "triggers": {
    "crons": ["0 1 * * *"]
  }
}
