{
  "name": "turf-nova-ai-2",
  "compatibility_date": "2026-08-01",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/blog.html", "/article.html", "/cgu.html", "/confidentialite.html"]
  },
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "5ce12447f8b641279bc706893a6e8bc3"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "turf-nova-db",
      "database_id": "9e74bb9b-22d1-4945-805b-3a3d48590b65"
    }
  ],
  "triggers": {
    "crons": [
      "0 1 * * *",
      "0 6 * * *",
      "*/30 * * * *",
      "*/15 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "VAPID_PUBLIC_KEY": "BHcJMlQ0XsIboi6iCKs2IVfmEvU-Hylyx0m2ZWxbE4joYSxPOlHrcuXzFDmG4pxmWXwrx5U0pWBLIbbV-vYy0s8",
    "VAPID_SUBJECT": "https://turf-nova-ai-2.kambourodrigue.workers.dev"
  }
}
